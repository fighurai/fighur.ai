# --- Public URL (metadata, client hints) ---
# Use your real apex, e.g. https://fighurai.ai
NEXT_PUBLIC_SITE_URL=https://fighurai.ai

# --- OAuth redirect base (must match Google / Azure app registration) ---
# Usually same origin as the site:
SMILE_OAUTH_BASE_URL=https://fighurai.ai

# --- Sealing: sessions + encrypted user connection files (min 16 chars) ---
SMILE_APP_SECRET=replace-with-long-random-string
# If you omit SMILE_APP_SECRET, set instead:
# SMILE_OAUTH_COOKIE_SECRET=replace-with-long-random-string

# --- Auth: disable insecure email-only sign-in (use password + SSO instead) ---
# SMILE_ALLOW_DEMO_EMAIL_AUTH=false

# --- Plans: comma-separated emails auto-receive Pro (all models) ---
# hello@fighurai.com is always Pro + admin in code; add others here if needed:
# SMILE_PRO_EMAILS=you@example.com

# --- Stripe Pro billing ---
# Dashboard: https://dashboard.stripe.com/test/apikeys
# Create a recurring Price for Pro, then set STRIPE_PRICE_ID=price_...
# Webhook endpoint: https://fighur.ai/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Dev only: POST /api/billing/upgrade sets plan=pro without Stripe ---
# SMILE_ALLOW_DEV_PRO_UPGRADE=false

# --- Per-user data on disk (profiles, encrypted OAuth tokens) ---
# Serverless hosts wipe disk between invocations — use a VPS, Fly volume, Railway volume, etc.,
# and point this to a persistent path. Example:
# SMILE_USER_DATA_DIR=/var/lib/smile-ai/data

# --- Model providers (set at least one — required for chat on fighur.ai) ---
# In Vercel: Project → Settings → Environment Variables → Production → Redeploy
ANTHROPIC_API_KEY=
# SMILE_DEFAULT_CHAT_MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=

# --- Google OAuth (SSO sign-in + optional Gmail/Calendar connect) ---
# Register redirect URIs in Google Cloud → Credentials → OAuth client (Web):
#   https://fighur.ai/api/auth/sso/google/callback
#   https://fighur.ai/api/connect/google/callback
# See docs/GOOGLE_SSO_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft OAuth (fighur ai app — see docs/CONNECTORS_SETUP.md) ---
# MICROSOFT_CLIENT_ID=4c5436c0-3e68-4c79-af81-8d3a745f6d2c
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Web search (optional — DuckDuckGo instant fallback works without a key) ---
# Brave: https://brave.com/search/api/ (recommended for full results)
# BRAVE_SEARCH_API_KEY=
# Tavily: https://tavily.com/
# TAVILY_API_KEY=

# --- Read linked web pages (fetch_url tool; Jina Reader works without a key) ---
# JINA_API_KEY=

# --- Image generation (DALL·E 3 via OpenAI — same key as chat) ---
# Uses OPENAI_API_KEY above. Required for photo-realistic generate_image tool in Canvas.

# --- Scheduled Tasks (Vercel Cron → /api/cron/tasks daily on Hobby) ---
# Hobby only allows once-per-day crons. Use "0 14 * * *" (see vercel.json).
# On Pro you can set "*/15 * * * *" for every 15 minutes.
# Vercel injects Authorization: Bearer <CRON_SECRET> when this is set.
# CRON_SECRET=replace-with-long-random-string
# Durable task storage also needs Blob (or SMILE_USER_DATA_DIR on a persistent host):
# BLOB_READ_WRITE_TOKEN=

# --- RouteLLM Auto model preferences (optional comma-separated catalog ids) ---
# SMILE_ROUTE_CODING=anthropic:claude-sonnet-4-5-20250929,openai:gpt-4o
# SMILE_ROUTE_RESEARCH=anthropic:claude-sonnet-4-5-20250929,openai:gpt-4o
# SMILE_ROUTE_CREATIVE=openai:gpt-4o,anthropic:claude-sonnet-4-5-20250929
# SMILE_ROUTE_CHEAP_FAST=openai:gpt-4o-mini,groq:llama-3.3-70b-versatile
# SMILE_ROUTE_CHAT=anthropic:claude-sonnet-4-5-20250929,openai:gpt-4o-mini

# --- Optional ---
# OPENROUTER_REFERER=https://fighurai.ai

# --- Slack connect (optional) ---
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Redirect URI: https://fighur.ai/api/connect/slack/callback

# --- Apple Sign In + App Store (after Developer Program enrollment) ---
# Bundle ID: ai.fighur.app
# Create: App ID + Services ID (Sign in with Apple) + Key (.p8) with Sign In with Apple
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_SERVICES_ID=ai.fighur.app.web
# APPLE_BUNDLE_ID=ai.fighur.app
# Paste .p8 contents (use \n for newlines in env vars):
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Return URL for Services ID: https://fighur.ai/api/auth/sso/apple/callback
#
# --- Apple IAP (StoreKit) ---
# Create auto-renewable subscription in App Store Connect, e.g.:
# APPLE_IAP_PRODUCT_ID=ai.fighur.app.pro.monthly
# NEXT_PUBLIC_APPLE_IAP_PRODUCT_ID=ai.fighur.app.pro.monthly
# Server Notifications V2 URL: https://fighur.ai/api/billing/apple/notifications
# Dev only (never in production): APPLE_IAP_ALLOW_UNVERIFIED=1
