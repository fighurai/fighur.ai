{
  "manifest_version": 3,
  "name": "FIGHURAI Colors",
  "version": "1.2.1",
  "description": "Apply FIGHURAI Colors (background + text) on any website. Included with FIGHURAI Pro. Does not collect personal account details.",
  "homepage_url": "https://fighur.ai/extension",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FIGHURAI Colors",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://fighur.ai/*",
    "https://www.fighur.ai/*",
    "https://fighurai.ai/*",
    "https://www.fighurai.ai/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://fighur.ai/*",
        "https://www.fighur.ai/*",
        "https://fighurai.ai/*",
        "https://www.fighurai.ai/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["site-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
